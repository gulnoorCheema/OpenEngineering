{
  "name": "openengineering",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro check && astro build",
    "preview": "astro preview --host 127.0.0.1",
    "test": "tsx --test tests/*.test.ts",
    "new-exhibit": "node scripts/new-exhibit.mjs",
    "licenses": "node scripts/licenses.mjs",
    "studio": "node scripts/capture-server.mjs",
    "format": "prettier --write src scripts tests docs launch .github *.md *.json astro.config.mjs",
    "audit:licenses": "astro build --config scripts/license-audit.config.mjs && node scripts/audit-browser-licenses.mjs"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.5",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "astro": "^7.3.2",
    "html-to-image": "^1.11.13",
    "lucide-react": "^1.45.0",
    "react": "19.2",
    "react-dom": "19.2",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^24.13.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^1.0.0",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
