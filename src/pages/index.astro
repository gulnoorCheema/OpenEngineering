---
import Layout from '../layouts/Layout.astro';
import { exhibits } from '../content/exhibits';
import HomeHero from '../components/HomeHero';
import MechanismCollection from '../components/MechanismCollection.astro';
import '../styles/home.css';
---

<Layout
  showcase
  imageId="home"
  description="Understand machines in 3D. A free, open-source collection of code, models and stories to explore, reuse and improve."
>
  <HomeHero count={exhibits.length} client:load />
  <MechanismCollection />
</Layout>
<script>
  import { legacyEngineLink } from '../lib/home';
  import { path } from '../lib/paths';
  const destination = legacyEngineLink(location.search, location.hash, path('/exhibits/engine/'));
  if (destination) location.replace(destination);
</script>
