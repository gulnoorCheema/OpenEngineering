---
import { exhibits } from '../content/exhibits';
import { path } from '../lib/paths';
---

<section class="collection" id="collection">
  <div class="section-heading">
    <div>
      <div class="eyebrow">FOLLOW YOUR CURIOSITY</div>
      <h2>There’s more under the surface.</h2>
    </div>
    <span class="collection-count">
      {String(exhibits.length).padStart(2, '0')} EXHIBITS / FREE TO EXPLORE
    </span>
  </div>
  {[
    { title: 'New ways to wonder', items: exhibits.filter((e) => e.featured) },
    { title: 'Where it began', items: exhibits.filter((e) => !e.featured) },
  ].map((group) => (
    <div class="collection-group">
      <h3 class="collection-group-title">{group.title}</h3>
      <div class="collection-grid">
        {group.items.map((e) => (
          <a class="exhibit-card" href={path(`/exhibits/${e.id}/`)}>
            <img
              src={path(`/exhibits/${e.id}.png`)}
              alt={`${e.title}: an original 3D cutaway`}
              loading="lazy"
              width="720"
              height="540"
            />
            <div class="card-body">
              <span class="eyebrow">
                {e.number} / {e.duration} OF CURIOSITY
              </span>
              <h3>
                {e.title}
                <span aria-hidden="true">↗</span>
              </h3>
              <p>{e.question}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  ))}
  <div class="contribute-strip">
    <div>
      <span class="eyebrow">THE NEXT EXHIBIT COULD BE YOURS</span>
      <h3>Help someone have an “oh, that’s how” moment.</h3>
      <p>The code, design rules, and a small starter exhibit are yours to build on.</p>
    </div>
    <a href={path('/contribute/')} class="outline-link">
      Make an exhibit <span>↗</span>
    </a>
  </div>
</section>
