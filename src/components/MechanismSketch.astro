---
const { id, title = 'Mechanism diagram' } = Astro.props;
---

<svg viewBox="0 0 400 210" role="img" aria-label={title} class="mechanism-sketch">
  <defs>
    <pattern id={`grid-${id}`} width="20" height="20" patternUnits="userSpaceOnUse">
      <circle cx="1" cy="1" r=".7" fill="#b6b9b0" />
    </pattern>
  </defs>
  <rect width="400" height="210" fill="#ecece4" />
  <rect width="400" height="210" fill={`url(#grid-${id})`} opacity=".5" />
  {id === 'engine' ? (
    <g stroke-linejoin="round">
      <path d="M160 40V131M240 40V131M155 40H245" stroke="#879593" stroke-width="9" fill="none" />
      <rect x="168" y="70" width="64" height="32" rx="3" fill="#d5a756" />
      <path d="M200 97L220 155" stroke="#829294" stroke-width="11" />
      <circle cx="200" cy="162" r="27" fill="none" stroke="#d85b28" stroke-width="12" />
      <path d="M200 162L220 155" stroke="#d85b28" stroke-width="13" />
      <circle cx="220" cy="155" r="6" fill="#f7f5f0" />
      <path d="M180 51L190 65M204 50L201 65M222 51L213 65" stroke="#da642a" stroke-width="3" />
      <text x="275" y="89">
        PUSH
      </text>
      <text x="265" y="169">
        ROTATE
      </text>
      <path d="M246 84H265M237 162H255" stroke="#7b827b" />
    </g>
  ) : id === 'gears' ? (
    <g>
      <g transform="translate(150 105)">
        <circle r="36" fill="none" stroke="#d45c2c" stroke-width="16" />
        {Array.from({ length: 16 }, (_, i) => (
          <rect
            x="-5"
            y="-52"
            width="10"
            height="16"
            rx="2"
            fill="#d45c2c"
            transform={`rotate(${i * 22.5})`}
          />
        ))}
        <circle r="7" fill="#404e54" />
        <circle cx="0" cy="-26" r="3" fill="#d45c2c" />
      </g>
      <g transform="translate(257 105)">
        <circle r="58" fill="none" stroke="#527f96" stroke-width="17" />
        {Array.from({ length: 24 }, (_, i) => (
          <rect
            x="-5"
            y="-75"
            width="10"
            height="17"
            rx="2"
            fill="#527f96"
            transform={`rotate(${i * 15 + 7.5})`}
          />
        ))}
        <circle r="7" fill="#404e54" />
      </g>
      <text x="49" y="185">
        SPEED ↘
      </text>
      <text x="270" y="185">
        TORQUE ↗
      </text>
    </g>
  ) : (
    <g>
      <path d="M85 100H315" stroke="#697b84" stroke-width="11" />
      <rect x="69" y="58" width="26" height="86" rx="10" fill="#39464e" />
      <rect x="305" y="58" width="26" height="86" rx="10" fill="#39464e" />
      <ellipse cx="200" cy="100" rx="55" ry="63" fill="#e4e3d9" stroke="#8a9897" stroke-width="9" />
      <path d="M153 72L183 83V118L153 130Z" fill="#d45c2c" />
      <path d="M247 72L217 83V118L247 130Z" fill="#527f96" />
      <path d="M188 64H212L200 83ZM188 137H212L200 118Z" fill="#d5a756" />
      <path d="M200 53V148" stroke="#566975" stroke-width="4" />
      <text x="58" y="178">
        LESS
      </text>
      <text x="294" y="178">
        MORE
      </text>
    </g>
  )}
</svg>
