---
import { ArrowUpRight } from 'lucide-react';
import { path, REPOSITORY } from '../lib/paths';
---

<footer class="home-footer">
  <div class="home-container home-footer-main">
    <h2>
      Open to everyone.
      <br />
      Yours to build on.
    </h2>
    <div class="home-footer-invitation">
      <a class="home-text-link" href={path('/contribute/')}>
        Help grow the collection <ArrowUpRight size={22} aria-hidden="true" />
      </a>
      <p>
        Reuse a model. Improve a story.
        <br />
        Add the mechanism you wish existed.
        <br />
        You don’t have to write code to contribute.
      </p>
    </div>
  </div>
  <div class="home-container home-footer-bottom">
    <span>OpenEngineering</span>
    <div>
      <a href={path('/sources/')}>Sources & credits</a>
      <a href={path('/build-log/')}>Build log</a>
      <a href={REPOSITORY}>
        Get the source <ArrowUpRight size={15} aria-hidden="true" />
      </a>
    </div>
  </div>
</footer>
