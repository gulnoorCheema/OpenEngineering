---
import '@fontsource/dm-sans/400.css';
import '@fontsource/dm-sans/500.css';
import '@fontsource/dm-sans/600.css';
import '@fontsource/dm-sans/700.css';
import '@fontsource/space-grotesk/500.css';
import '@fontsource/space-grotesk/600.css';
import '@fontsource/ibm-plex-mono/400.css';
import '../styles/global.css';
import CaptureTools from '../components/CaptureTools';
import { path, REPOSITORY } from '../lib/paths';
const {
  title = 'OpenEngineering — understand how machines work',
  description = 'Free, open-source interactive 3D stories. Take apart an engine, experiment with gears, and discover the hidden ingenuity in everyday machines.',
  noindex = false,
  imageId = 'engine',
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="theme-color" content="#f7f5f0" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={path('/favicon.svg')} type="image/svg+xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(path(`/social/${imageId}.png`), Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="OpenEngineering: understand how machines work, and play with them in 3D."
    />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to the exhibit
    </a>
    <header class="site-header">
      <a class="brand" href={path('/')} aria-label="OpenEngineering home">
        <img src={path('/favicon.svg')} alt="" width="32" height="32" />
        <span>
          Open<span class="brand-light">Engineering</span>
        </span>
      </a>
      <nav aria-label="Main navigation">
        <a href={path('/#collection')}>The collection</a>
        <a href={path('/about/')}>Our idea</a>
        <a class="nav-contribute" href={path('/contribute/')}>
          Make an exhibit <span aria-hidden="true">↗</span>
        </a>
        <a class="github-link" href={REPOSITORY} aria-label="OpenEngineering on GitHub">
          <svg viewBox="0 0 24 24" width="21" height="21" fill="currentColor" aria-hidden="true">
            <path d="M12 .8a11.2 11.2 0 0 0-3.54 21.82c.56.1.77-.24.77-.54v-2.1c-3.14.68-3.8-1.33-3.8-1.33-.51-1.3-1.25-1.65-1.25-1.65-1.02-.7.08-.69.08-.69 1.13.08 1.73 1.16 1.73 1.16 1 1.72 2.62 1.22 3.26.93.1-.73.4-1.22.72-1.5-2.5-.28-5.13-1.25-5.13-5.55 0-1.23.44-2.24 1.16-3.03-.12-.28-.5-1.43.11-2.99 0 0 .95-.3 3.08 1.15A10.7 10.7 0 0 1 12 6.1c.95 0 1.9.13 2.8.38 2.13-1.45 3.07-1.15 3.07-1.15.61 1.56.23 2.71.12 3a4.34 4.34 0 0 1 1.16 3.02c0 4.32-2.63 5.27-5.14 5.55.4.35.76 1.03.76 2.08v3.1c0 .3.2.64.77.54A11.2 11.2 0 0 0 12 .8Z" />
          </svg>
        </a>
      </nav>
    </header>
    <main id="main">
      <noscript>
        <p class="noscript-note">
          The 3D player needs JavaScript. You can still open the complete written story and its
          sources below.
        </p>
      </noscript>
      <slot />
    </main>
    <CaptureTools client:idle />
    <footer class="site-footer">
      <a class="brand footer-brand" href={path('/')}>
        OpenEngineering<span class="open-mark">↗</span>
      </a>
      <p>A little curiosity goes a long way.</p>
      <div>
        <span>Free to explore. Open to everyone.</span>
        <a href={path('/sources/')}>Sources & credits</a>
        <a href={path('/build-log/')}>Built with Astra</a>
      </div>
    </footer>
  </body>
</html>
